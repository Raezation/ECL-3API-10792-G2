@model EmprestimoForm
@{ ViewData["Title"] = "Novo empréstimo"; }
<h1>Registar empréstimo</h1><p>Confirme o livro, o leitor e o prazo de devolução. A disponibilidade é verificada ao guardar.</p>
<form asp-action="Criar" method="post" class="formulario">
    <div asp-validation-summary="All" class="validacao" role="alert"></div>
    <div><label asp-for="LivroId"></label><select asp-for="LivroId" asp-items="Model.Livros"><option value="">Selecione um livro</option></select><span asp-validation-for="LivroId"></span></div>
    <div><label asp-for="LeitorId"></label><select asp-for="LeitorId" asp-items="Model.Leitores"><option value="">Selecione um leitor</option></select><span asp-validation-for="LeitorId"></span></div>
    <div><label asp-for="DataInicio"></label><input asp-for="DataInicio" type="date" /><span asp-validation-for="DataInicio"></span></div>
    <div><label asp-for="DataPrevista"></label><input asp-for="DataPrevista" type="date" /><span asp-validation-for="DataPrevista"></span></div>
    <div class="acoes"><button type="submit">Registar empréstimo</button><a asp-action="Index">Cancelar</a></div>
</form>
