@model List<Emprestimo>
@{ ViewData["Title"] = "Empréstimos em atraso"; DateTime hoje = ViewBag.Hoje; }
<p class="sobretitulo">ACOMPANHAMENTO DAS DEVOLUÇÕES</p><h1>Empréstimos em atraso</h1>
<p>Empréstimos sem devolução, com data prevista anterior a @hoje.ToString("dd/MM/yyyy").</p>
@if (Model.Count == 0) { <p>Não existem empréstimos em atraso.</p> }
else
{
<div class="tabela"><table><thead><tr><th>Livro</th><th>Leitor / Contacto</th><th>Data prevista</th><th>Dias de atraso</th><th>Ação</th></tr></thead><tbody>
@foreach (var e in Model)
{ <tr><td>@e.Livro.Titulo</td><td>@e.Leitor.Numero · @e.Leitor.Nome<small>@e.Leitor.Email</small></td><td>@e.DataPrevista.ToString("dd/MM/yyyy")</td><td>@((hoje-e.DataPrevista.Date).Days)</td><td><a asp-action="Devolver" asp-route-id="@e.Id">Registar devolução</a></td></tr> }
</tbody></table></div>
}
<p><a asp-action="Index">Consultar todos os empréstimos</a></p>
