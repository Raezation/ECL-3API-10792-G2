@model LeitorForm
@{ var editar = Model.Id != 0; ViewData["Title"] = editar ? "Editar leitor" : "Novo leitor"; }
<h1>@ViewData["Title"]</h1><p>O número deve ser único. Os dados de demonstração são fictícios.</p>
<form asp-action="@(editar ? "Editar" : "Criar")" asp-route-id="@Model.Id" method="post" class="formulario">
    <div asp-validation-summary="All" class="validacao" role="alert"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Versao" />
    <div><label asp-for="Nome"></label><input asp-for="Nome" /><span asp-validation-for="Nome"></span></div>
    <div><label asp-for="Numero"></label><input asp-for="Numero" /><span asp-validation-for="Numero"></span></div>
    <div><label asp-for="Email"></label><input asp-for="Email" type="email" /><span asp-validation-for="Email"></span></div>
    <div class="acoes"><button type="submit">Guardar leitor</button><a asp-action="Index">Cancelar</a></div>
</form>
